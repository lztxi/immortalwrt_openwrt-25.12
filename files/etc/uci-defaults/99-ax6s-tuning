#!/bin/sh
# Redmi AX6S 首次开机执行的默认调优 (执行一次后被系统自动删除)
# 如需调整, 刷机后直接在 /etc/config/system 里改即可

# ---------- ZRam ----------
# 内存 256MB: 取 64MB 做压缩内存 (默认算法是 MemTotal/2048 ≈ 128MB, 偏激进)
# lz4 兼顾压缩率与 CPU 占用, 长时间高负载更稳
uci -q batch <<'EOF'
set system.@system[0].zram_size_mb=64
set system.@system[0].zram_comp_algo=lz4
set system.@system[0].zram_priority=100
commit system
EOF
/etc/init.d/zram enable

# ---------- 基础信息 ----------
uci -q batch <<'EOF'
set system.@system[0].hostname='ImmortalWrt-AX6S'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
commit system
EOF

# ---------- 后台管理地址 ----------
# 沿用红米原厂网段 192.168.31.x, DHCP 池默认 192.168.31.100 - 249
uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.31.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='64'
commit network
EOF

# ---------- 软件流卸载 (flow offload) ----------
# MT7622 无开源硬件 NAT, 用软件 flow offload 降低转发 CPU 占用
# 若遇到个别网站打不开或游戏掉线, 把 offloading 改成 0 即可
uci -q batch <<'EOF'
set firewall.@defaults[0].flow_offloading=1
set firewall.@defaults[0].flow_offloading_hw=0
commit firewall
EOF

exit 0
