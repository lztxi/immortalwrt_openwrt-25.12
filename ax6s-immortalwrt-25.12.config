#
# ImmortalWrt  openwrt-25.12  ——  Xiaomi Redmi AX6S (AX3200)
# Target : mediatek/mt7622  |  aarch64_cortex-a53  |  Kernel 6.12
# Flash  : 128MB NAND        |  RAM: 256MB
#
# 用途: GitHub Actions 在线编译, 放到源码根目录命名为 .config 即可
# 校验: 所有 CONFIG_PACKAGE_* 包名均对照 immortalwrt/immortalwrt +
#       immortalwrt/packages + immortalwrt/luci (openwrt-25.12) 实际源码树核验
#
# 必含三项: OpenClash / luci-app-argon-config / ZRam
# 已开启:   IPv6(原生 DHCPv6 + RA)
#

#=================================================================
# 1. 目标设备
#=================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_xiaomi_redmi-router-ax6s=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="mt7622"
CONFIG_TARGET_PROFILE="DEVICE_xiaomi_redmi-router-ax6s"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_TARGET_ROOTFS_SQUASHFS=y

#=================================================================
# 2. 内核层优化 (稳定性 / 网络性能)
#=================================================================
# BBR 拥塞控制: 对代理出国、长距离链路收益明显, 纯转发流量不受影响
# 这里只编译进内核, 是否启用交给 sysctl(见 files/etc/sysctl.d), 可随时回退
CONFIG_KERNEL_TCP_CONG_BBR=y
# swap 支持 (ZRam 依赖)
CONFIG_KERNEL_SWAP=y
# ZRam 压缩后端选 lz4: 相比 zstd 更省 CPU, 双核 A53 上延迟更低, 长时间高负载更稳
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

#=================================================================
# 3. ZRam (必选) —— 256MB 内存下防 OOM 的关键
#=================================================================
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

#=================================================================
# 4. IPv6 (原生 IPv6: DHCPv6 + RA, 无 6in4/6to4/6rd 隧道)
#=================================================================
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_kmod-nf-reject6=y

#=================================================================
# 5. LuCI 界面与主题 (含必选 argon)
#=================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
# 简体中文: 设置后构建系统会自动为所有支持 zh_Hans 的组件挂上翻译包
CONFIG_LUCI_LANG_zh_Hans=y
# 必选: Argon 主题 + 配置插件
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# 界面压缩, 让 LuCI 在低端设备上加载更快
CONFIG_LUCI_JSMIN=y
CONFIG_LUCI_CSSTIDY=y
CONFIG_LUCI_SRCDIET=n

#=================================================================
# 6. OpenClash (必选) —— 依赖会被自动带上
#    依赖: dnsmasq-full bash curl ca-bundle ip-full ruby ruby-yaml
#          kmod-inet-diag kmod-nft-tproxy kmod-tun unzip luci-compat
#=================================================================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_iptables-nft=y

#=================================================================
# 7. 无线 (MT7915)
#=================================================================
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7622-firmware=y
CONFIG_PACKAGE_iwinfo=y

#=================================================================
# 8. 管理界面与转发基础
#    已按需求裁掉: DDNS / 带宽监视 / Watchcat / 网络唤醒 / UPnP /
#                  SQM 队列管理 / 网页终端
#    这七项互不依赖, 也没有其它必备组件引用, 裁剪后不影响
#    OpenClash / IPv6 / ZRam / Argon 任何功能
#=================================================================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_kmod-nft-offload=y       # 软件 flow offload, 提高千兆转发
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_nftables=y

#=================================================================
# 9. 拨号与网络基础
#=================================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_uclient-fetch=y

#=================================================================
# 10. 维护排障工具
#=================================================================
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

#=================================================================
# 11. 设备自带, 显式固定避免被 feeds 变化影响
#=================================================================
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_bridger=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-nls-utf8=y

#=================================================================
# 12. 构建选项: 启用 ccache (配合 GitHub Actions 缓存复用编译结果)
#     CCACHE 是 DEVEL 菜单下的子项, 必须同时开 CONFIG_DEVEL=y,
#     否则 make defconfig 会因为符号不可见而把 CONFIG_CCACHE 丢弃
#     缓存目录由 rules.mk 固定为 $(TOPDIR)/.ccache, 环境变量改不了
#=================================================================
CONFIG_DEVEL=y
CONFIG_CCACHE=y
